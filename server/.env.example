PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Paste Firebase Admin service-account JSON path OR set GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_PATH=
# Comma-separated Firebase UIDs given JUW admin privileges (not emails)
FIREBASE_ADMIN_UIDS=
# DEVELOPMENT ONLY: set true to allow testing public catalog without auth. Admin is still Firebase protected.
# Comma-separated Vite development origins
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
# Server-only Cloudinary credentials
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
