# ==========================================
# JUW Marketplace Environment Variables Template
# ==========================================

# ------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite)
# ------------------------------------------
# In production on Netlify, leave VITE_API_URL empty so requests use relative /api paths
# In local development, you can point to http://localhost:4000 (or leave empty to use Vite proxy)
VITE_API_URL=

# Firebase Web Client Configuration (Firebase Console > Project Settings > General > Your apps)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ------------------------------------------
# 2. BACKEND / NETLIFY FUNCTIONS ENVIRONMENT VARIABLES
# ------------------------------------------
# Firebase Admin Credentials (Choose OPTION A or OPTION B for Netlify):
# OPTION A (Recommended for Netlify): Paste entire service account JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"..."}

# OPTION B: Base64-encoded service account JSON (useful if avoiding multi-line issues)
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# OPTION C (Local development only): Path to service account file on disk
# FIREBASE_SERVICE_ACCOUNT_PATH=server/firebase-service-account.json

# Admin Authorization (Comma-separated Firebase UIDs of users with Super Admin privileges)
FIREBASE_ADMIN_UIDS=your_admin_firebase_uid_here

# Cloudinary Image Upload Credentials (Cloudinary Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Allowed CORS Origins (Optional on Netlify - same-origin and *.netlify.app are allowed automatically)
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174
